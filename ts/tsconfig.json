{
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"module": "preserve",
		"target": "esnext",
		"types": [
			"node"
		],
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		//		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		// Recommended Options
		"strict": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
		"allowImportingTsExtensions": true
	}
}
